// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  MERCHANT
}

enum DealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScraperStatus {
  ONLINE
  FAILING
  THROTTLED
  OFFLINE
}

enum SectorType {
  FOOD
  RIDE
  SKINCARE
}

enum ComplainStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AccountStatus {
  ACTIVE
  WARNING
  SUSPENDED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  role          Role          @default(USER)
  accountStatus AccountStatus @default(ACTIVE)
  complainCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  complaints        Complaint[]
  deals             Deal[]
  offerMatrixEdits  OfferMatrixSetting[]
}

model Deal {
  id               String     @id @default(cuid())
  title            String
  merchant         String
  sector           SectorType
  originalPrice    Float
  discountedPrice  Float
  discountPercent  Float
  couponCode       String?
  affiliateUrl     String?
  status           DealStatus @default(PENDING)
  validUntil       DateTime?
  submittedById    String?
  submittedBy      User?      @relation(fields: [submittedById], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model ScraperLog {
  id                 String        @id @default(cuid())
  botName            String
  targetUrl          String
  status             ScraperStatus
  responseLatencyMs  Int
  itemsScrapedCount  Int           @default(0)
  lastError          String?
  lastRunAt          DateTime      @default(now())
  createdAt          DateTime      @default(now())
}

model AffiliateLink {
  id              String   @id @default(cuid())
  partnerName     String
  originalDomain  String
  commissionRate  Float
  trackingUrl     String
  clicksCount     Int      @default(0)
  conversionsCount Int     @default(0)
  status          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FraudReport {
  id           String   @id @default(cuid())
  incidentId   String   @unique
  targetIp     String
  partnerName  String
  reason       String
  riskScore    Float
  status       String   @default("OPEN")
  dispatchedAt DateTime?
  createdAt    DateTime @default(now())
}

model Complaint {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  sector          SectorType
  serviceProvider String
  orderOrRideId   String?
  subject         String
  description     String         @db.Text
  status          ComplainStatus @default(OPEN)
  adminResponse   String?        @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OfferMatrixSetting {
  id                 String     @id @default(cuid())
  sector             SectorType
  providerName       String
  discountPercentage Float
  validityDays       Int
  isActive           Boolean    @default(true)
  updatedById        String?
  updatedBy          User?      @relation(fields: [updatedById], references: [id])
  updatedAt          DateTime   @updatedAt
}
